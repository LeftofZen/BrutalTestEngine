<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BrutalTestEngine</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Memory" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ShaderC" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Strings" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Vma" Version="2026.10.3" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
